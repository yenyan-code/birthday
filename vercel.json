{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/docs/(.*)", "destination": "/docs/$1" },
    { "source": "/css/(.*)", "destination": "/src/css/$1" },
    { "source": "/js/(.*)", "destination": "/src/js/$1" },
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/(.*)", "destination": "/src/$1" }
  ]
}
